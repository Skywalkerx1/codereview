+        entry["error"] = "no shadow Tech Lead seat available"
+        entry["cache_key"] = _shadow_cache_key(finding, region)
+        return entry
+    if rng is None:
+        seed = int(hashlib.sha256(str(
+            finding.get("id") or "").encode(
