+++ b/ops/duration_parser.py
@@ -0,0 +1,41 @@
+"""Parse compact duration strings into a number of seconds.
+
+Grammar: one or more ``<non-negative integer><unit>`` components,
+optionally separated by single spaces, where unit is one of
+``w`` (week), ``d`` (day), ``h`` (hour), ``m`` (minute), ``s``
+(second). Examples: ``"1h30m"`` = 5400, ``"45s"`` = 45, ``"2d"``,
+``"1w"``. Each unit may appear at most once. An empty or
+whitespace-only string, a bare number with no unit, an unknown
+unit, a repeated unit, a negative or fractional amount, or any
+other malformed text raises ``ValueError``. ``"0s"`` parses to 0.
+"""
+import re
+
+UNITS = {"w": 604800, "d": 86400, "h": 3600, "m": 60, "s": 1}
+TOKEN = re.compile(r"(\d+)([wdhms])")
+
+
+def parse_duration(text):
+    """Return the duration in ``text`` as an int number of seconds."""
+    if not isinstance(text, str):
+        raise ValueError("duration must be text")
+    body = text.strip()
+    if not body:
+        raise ValueError("empty duration")
+    compact = body.replace(" ", "")
+    if not compact:
+        raise ValueError("empty duration")
+    total = 0
+    seen = set()
+    pos = 0
+    while pos < len(compact):
+        match = TOKEN.match(compact, pos)
+        if not match:
+            raise ValueError(f"malformed duration at: {compact[pos:]!r}")
+        amount, unit = int(match.group(1)), match.group(2)
+        if unit in seen:
+            raise ValueError(f"duplicate unit: {unit!r}")
+        seen.add(unit)
+        total += amount * UNITS[unit]
+        pos = match.end()
+    return total
