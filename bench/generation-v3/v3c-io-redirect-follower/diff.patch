+"""Redirect following over a stub transport.
+
+A *transport* is any callable taking a :class:`Request` and
+returning a :class:`Response`; no real network is involved.
+
+Contract:
+- Redirect statuses are 301, 302, 303, 307 and 308 with a
+  ``Location`` header.  Relative locations resolve against the
+  current URL.  A 303 turns the follow-up into a GET; other
+  redirects keep the method.
+- At most ``max_redirects`` redirects are followed; one more
+  raises :class:`TooManyRedirectsError`.
+- The ``Authorization`` header is stripped whenever the redirect
+  target's host differs from the current host (compared
+  case-insensitively) and preserved on same-host redirects.
+- Revisiting a URL already seen in the chain raises
+  :class:`RedirectLoopError`.  Non-redirect responses, and
+  redirects without ``Location``, are returned as-is.
+"""
+from __future__ import annotations
+from urllib.parse import urljoin, urlparse
+
+_REDIRECT_STATUSES = {301, 302, 303, 307, 308}
+
+class RedirectError(RuntimeError):
+    """Base class for redirect-following failures."""
+
+
+class TooManyRedirectsError(RedirectError):
+    """The redirect budget was exhausted."""
+
+class RedirectLoopError(RedirectError):
+    """The chain revisited a URL."""
+
+
+class Request:
+    """A minimal HTTP request model (method, url, headers)."""
+    def __init__(self, method: str, url: str, headers: dict | None = None):
+        self.method = method
+        self.url = url
+        self.headers = dict(headers or {})
+
+
+class Response:
+    """A minimal HTTP response model (status, headers, body)."""
+    def __init__(self, status: int, headers: dict | None = None, body: bytes = b""):
+        self.status = status
+        self.headers = dict(headers or {})
+        self.body = body
+
+
+def _header(headers: dict, name: str):
+    for key, value in headers.items():
+        if key.lower() == name.lower():
+            return value
+    return None
+
+
+def follow_redirects(request: Request, transport,
+                     max_redirects: int = 5) -> Response:
+    """Send ``request`` via ``transport``, following redirects."""
+    if max_redirects < 0:
+        raise ValueError("max_redirects must be non-negative")
+    seen = {request.url}
+    current = request
+    followed = 0
+    while True:
+        response = transport(current)
+        if response.status not in _REDIRECT_STATUSES:
+            return response
+        location = _header(response.headers, "Location")
+        if location is None:
+            return response
+        if followed >= max_redirects:
+            raise TooManyRedirectsError(
+                f"more than {max_redirects} redirects")
+        target = urljoin(current.url, location)
+        if target in seen:
+            raise RedirectLoopError(f"redirect loop at {target}")
+        seen.add(target)
+        headers = dict(current.headers)
+        old_host = (urlparse(current.url).hostname or "").lower()
+        new_host = (urlparse(target).hostname or "").lower()
+        if new_host != old_host:
+            headers = {k: v for k, v in headers.items()
+                       if k.lower() != "authorization"}
+        method = "GET" if response.status == 303 else current.method
+        current = Request(method, target, headers)
+        followed += 1
