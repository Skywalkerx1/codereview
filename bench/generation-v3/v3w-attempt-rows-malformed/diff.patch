+"""Defensive parsing of gate-attempts telemetry (.jsonl).
+
+The telemetry inventory scans an append-only JSON-lines file of
+gate attempts. The file is written by several producers and can
+contain torn or hand-edited lines.
+
+Contract: blank lines are skipped silently. A non-blank line that
+does not parse as a JSON object is skipped AND counted as
+malformed -- one bad row must never abort the scan. Returns
+``(rows, malformed_count)`` where *rows* are the parsed objects
+in file order.
+"""
+
+import json
+
+
+def parse_attempt_rows(path):
+    """Parse the JSON-lines file at *path* per the contract."""
+    with open(path, encoding="utf-8") as fh:
+        rows = [json.loads(ln) for ln in fh if ln.strip()]
+    return rows, 0
+
+
+def count_providers(rows):
+    """Map each row's first seat provider to its row count."""
+    counts = {}
+    for row in rows:
+        seats = row.get("seats") or []
+        if seats:
+            name = seats[0].get("provider", "?")
+            counts[name] = counts.get(name, 0) + 1
+    return counts
