@@ -0,0 +1,43 @@
+"""Request-ID propagation with a strict acceptance rule.
+
+Contract:
+- An incoming request ID is propagated unchanged ONLY when it
+  fully matches the safe pattern: 8 to 64 characters drawn from
+  ASCII letters, digits, ``-``, ``_`` and ``.`` -- nothing else
+  (no spaces, slashes, control characters, or non-ASCII).
+- Anything else -- missing, empty, too short, too long, or with
+  an unsafe character -- is replaced by a freshly generated ID;
+  the untrusted value is never echoed into logs or responses.
+- Fresh IDs come from the ``generator`` callable when one is
+  supplied; otherwise a random 32-character lowercase hex string
+  (``uuid4().hex``) is used, which itself satisfies the pattern.
+- ``is_valid_request_id`` exposes the same acceptance rule.
+"""
+
+from __future__ import annotations
+
+import re
+import uuid
+
+_PATTERN = re.compile(r"\A[A-Za-z0-9._-]{8,64}\Z")
+
+
+def is_valid_request_id(value) -> bool:
+    """Return True when ``value`` satisfies the acceptance rule."""
+    return isinstance(value, str) and bool(_PATTERN.match(value))
+
+
+def _fresh_id() -> str:
+    return uuid.uuid4().hex
+
+
+def resolve_request_id(incoming, generator=None) -> str:
+    """Return ``incoming`` if valid, else a fresh generated ID."""
+    if is_valid_request_id(incoming):
+        return incoming
+    if generator is not None:
+        produced = generator()
+        if is_valid_request_id(produced):
+            return produced
+        return _fresh_id()
+    return _fresh_id()
