diff --git a/release/semver_cmp.py b/release/semver_cmp.py
new file mode 100644
--- /dev/null
+++ b/release/semver_cmp.py
@@ -0,0 +1,62 @@
+"""Semantic version parsing and ordering (semver 2.0.0).
+
+Contract: a version is ``MAJOR.MINOR.PATCH`` (non-negative ints, no
+leading zeros), optionally ``-prerelease`` (dot-separated numeric
+or alphanumeric identifiers, no empty identifiers, numeric ones
+without leading zeros) and optionally ``+build`` metadata, which
+is IGNORED for ordering. Ordering: compare major, minor, patch
+numerically; a release outranks each of its prereleases; between
+prereleases, identifiers compare left to right -- numeric
+identifiers compare numerically and rank BELOW alphanumeric ones,
+alphanumeric compare in ASCII order, and a shorter identifier list
+ranks below a longer one when all shared identifiers are equal.
+Malformed versions raise ``ValueError``.
+"""
+import re
+
+PATTERN = re.compile(
+    r"^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)"
+    r"(?:-((?:0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*)"
+    r"(?:\.(?:0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?"
+    r"(?:\+([0-9a-zA-Z-]+(?:\.[0-9a-zA-Z-]+)*))?$")
+
+
+def parse_version(text):
+    """Return (major, minor, patch, prerelease-tuple) for ``text``."""
+    if not isinstance(text, str):
+        raise ValueError("version must be text")
+    match = PATTERN.match(text)
+    if not match:
+        raise ValueError(f"invalid semantic version: {text!r}")
+    pre = match.group(4)
+    identifiers = ()
+    if pre is not None:
+        identifiers = tuple(
+            int(part) if part.isdigit() else part
+            for part in pre.split("."))
+    return (int(match.group(1)), int(match.group(2)),
+            int(match.group(3)), identifiers)
+
+
+def _pre_key(identifiers):
+    # Numeric ids sort as (0, value, ""), alphanumeric as (1, 0, text);
+    # tuple comparison then also gives shorter-prefix < longer.
+    return tuple((0, part, "") if isinstance(part, int)
+                 else (1, 0, part) for part in identifiers)
+
+
+def compare_versions(left, right):
+    """Return -1, 0 or 1 as ``left`` orders before/equal/after."""
+    a, b = parse_version(left), parse_version(right)
+    if a[:3] != b[:3]:
+        return -1 if a[:3] < b[:3] else 1
+    if not a[3] and not b[3]:
+        return 0
+    if not a[3]:
+        return 1   # release outranks any prerelease
+    if not b[3]:
+        return -1
+    ka, kb = _pre_key(a[3]), _pre_key(b[3])
+    if ka == kb:
+        return 0
+    return -1 if ka < kb else 1
