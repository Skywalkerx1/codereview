+++ b/extract/htmltext.py
@@ -0,0 +1,70 @@
+"""Extracting plain text from an HTML fragment.
+
+Contract for ``html_to_text``:
+- The contents of ``script`` and ``style`` elements are excluded
+  entirely, including nested markup inside them.
+- Character references are decoded (``&amp;`` becomes ``&``,
+  ``&#233;`` becomes the accented character, and so on).
+- Block-level elements (p, div, li, headings, tr, section,
+  article, blockquote, table, ul, ol, pre) and ``br`` separate
+  the text around them with newlines.
+- Within a line, runs of whitespace collapse to single spaces;
+  empty lines are dropped, so the result has no leading,
+  trailing, or doubled blank lines.
+- An empty or markup-only fragment yields ``""``.
+"""
+
+from __future__ import annotations
+
+from html.parser import HTMLParser
+
+_SKIP = {"script", "style"}
+_BLOCK = {
+    "p", "div", "li", "tr", "h1", "h2", "h3", "h4", "h5", "h6",
+    "section", "article", "blockquote", "table", "ul", "ol",
+    "pre", "header", "footer",
+}
+
+
+class _TextExtractor(HTMLParser):
+    def __init__(self):
+        super().__init__(convert_charrefs=True)
+        self.parts: list = []
+        self._skip_depth = 0
+
+    def handle_starttag(self, tag, attrs):
+        if tag in _SKIP:
+            self._skip_depth += 1
+            return
+        if self._skip_depth:
+            return
+        if tag in _BLOCK or tag == "br":
+            self.parts.append("\n")
+
+    def handle_endtag(self, tag):
+        if tag in _SKIP:
+            if self._skip_depth:
+                self._skip_depth -= 1
+            return
+        if self._skip_depth:
+            return
+        if tag in _BLOCK:
+            self.parts.append("\n")
+
+    def handle_data(self, data):
+        if not self._skip_depth:
+            self.parts.append(data)
+
+
+def html_to_text(fragment: str) -> str:
+    """Return the visible text of ``fragment`` per the contract."""
+    parser = _TextExtractor()
+    parser.feed(str(fragment))
+    parser.close()
+    raw = "".join(parser.parts)
+    lines = []
+    for line in raw.split("\n"):
+        cleaned = " ".join(line.split())
+        if cleaned:
+            lines.append(cleaned)
+    return "\n".join(lines)
